/* hero particles */
(function(){const c=$('#fx'),x=c.getContext('2d');if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;let w,h,p=[],vis=true;new IntersectionObserver(e=>{vis=e[0].isIntersecting}).observe(c);
function rs(){const r=Math.min(devicePixelRatio||1,2);w=c.offsetWidth;h=c.offsetHeight;c.width=w*r;c.height=h*r;x.setTransform(r,0,0,r,0,0);p=Array.from({length:Math.min(55,w/20|0)},()=>({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25}))}
