/* hero prompt anatomy */
const AN={Role:['Role','“You are a friendly career coach.” Setting a role tells the AI which knowledge and voice to use.'],Task:['Task','“Help me prepare for a job interview.” Say plainly what you want done.'],Context:['Context','“I am applying for a first marketing job.” Background lets the AI tailor the answer to you.'],Format:['Format','“Give me five likely questions with a short sample answer each.” Describe the shape of the result.']};
