<div class="lab">
<div>
<label for="l1">Role you want the AI to take</label><input type="text" id="l1" value="a patient marketing coach">
<label for="l2">Task</label><textarea id="l2" rows="3">Plan a four-week launch for my small online shop.</textarea>
