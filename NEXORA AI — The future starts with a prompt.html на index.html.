const SC=[['business','Business','💼','senior business strategist'],['marketing','Marketing','📈','world-class marketing strategist'],['coding','Programming','💻','senior software engineer'],['creative','Creative writing','✍️','professional creative writer'],['education','Education','🎓','expert educator and learning designer'],['research','Research','🔬','professional research analyst'],['design','Design','🎨','senior product and visual designer'],['productivity','Productivity','⚡','productivity and workflow expert']];
let sc='business',stText='',dl=null;
function stCats(){$('#cats').innerHTML=SC.map(c=>`<button type="button" class="cat ${c[0]===sc?'on':''}" data-id="${c[0]}" aria-pressed="${c[0]===sc}"><span aria-hidden="true">${c[2]}</span>${c[1]}</button>`).join('')}
