function stBuild(){const v=i=>$('#'+i).value.trim(),r=SC.find(c=>c[0]===sc)[3];return `# PROFESSIONAL AI PROMPT\n\n## ROLE\nAct as a ${r} with extensive real-world experience.\n\n## OBJECTIVE\n${v('sg')}\n\n## BACKGROUND AND CONTEXT\n${v('sx')||'Use the information provided in the objective. Ask for clarification if essential details are missing.'}\n\n## TARGET AUDIENCE\n${v('sa')||'Determine the most relevant audience from the context.'}\n\n## COMMUNICATION STYLE\n${$('#stn').value}\n\n## INTENDED AI PLATFORM\n${$('#spl').value}\n\n## INSTRUCTIONS\n1. Understand the objective before producing the final answer.\n2. Break complex tasks into clear, logical steps.\n3. Provide specific, practical and actionable recommendations.\n4. Use examples when they improve understanding.\n5. Explain technical concepts in accessible language.\n6. Identify assumptions and missing information.\n7. Never invent facts, sources, statistics or capabilities.\n8. If information is uncertain, clearly communicate the uncertainty.\n9. Optimize the response for usefulness, clarity and quality.\n\n## OUTPUT FORMAT\nPresent the result using clear headings, structured sections and concise explanations. Include an actionable conclusion.\n\nBefore finalizing, review your answer for accuracy, completeness and relevance.\n\nThe goal is not simply to produce an answer. The goal is to deliver an excellent, useful result.`}
$('#sg').addEventListener('input',()=>{$('#ser').textContent=''});
$('#sgo').onclick=()=>{if(!$('#sg').value.trim()){$('#ser').textContent='Describe what you want to achieve first.';$('#sg').focus();return}$('#ser').textContent='';stText=stBuild();$('#stp').textContent=stText;$('#sto').hidden=false;$('#stc').textContent='Copy prompt';$('#sto').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth',block:'start'})};
async function copyOk(t){try{await navigator.clipboard.writeText(t);return true}catch(e){const a=document.createElement('textarea');a.value=t;a.style.cssText='position:fixed;opacity:0';document.body.appendChild(a);a.select();let ok=false;try{ok=document.execCommand('copy')}catch(x){}a.remove();return ok}}
$('#stc').onclick=async()=>{if(!stText)return;const ok=await copyOk(stText);$('#stc').textContent=ok?'Copied':'Copy failed';toast(ok?'Prompt copied':'Copy failed: select the text and copy it manually');setTimeout(()=>{$('#stc').textContent='Copy prompt'},2000)};
(async()=>{try{dl=window.claude?await claude.use('downloads'):null}catch(e){dl=null}if(dl)$('#std').hidden=false})();
$('#std').onclick=async()=>{if(!dl||!stText)return;try{await dl.save({filename:'nexora-ai-prompt.txt',data:stText});toast('Prompt saved')}catch(e){if(!e||e.code!=='declined')toast('Download is unavailable here. Use Copy instead.')}};
